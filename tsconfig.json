{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "services/*": ["./src/services/*"],
      "store/*": ["./src/store/*"],
      "constants/*": ["./src/constants/*"],
      "components/*": ["./src/components/*"],
      "types/*": ["./src/types/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
